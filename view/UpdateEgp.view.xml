<mvc:View xmlns:mvc="sap.ui.core.mvc" controllerName="com.cu.s4hana.zlpuba001.controller.UpdateEgp" xmlns:uxap="sap.uxap" xmlns="sap.m"
	xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:dnd="sap.ui.core.dnd" xmlns:core="sap.ui.core">
	<Page id="idUpdateEgpPage" title="{i18n>Button.UpdateEgpNumber}" showHeader="true" showNavButton="true">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button type="Back" press="handleBackPress"/>
				</contentLeft>
				<contentMiddle>
					<Title text="{i18n>Button.UpdateEgpNumber}"/>
				</contentMiddle>
				<contentRight/>
			</Bar>
		</customHeader>
		<content>
			<!--<ObjectHeader responsive="true" intro="{prEgpData>/EGPWS0016/projectdetail/field6}"-->
			<!--	title="{prEgpData>/EGPWS0016/projectdetail/field19} / {prEgpData>/EGPWS0016/projectdetail/field5}"-->
			<!--	number="{ path: 'prEgpData>/EGPWS0016/projectdetail/field13', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"-->
			<!--	numberUnit="THB" numberState="Success" backgroundDesign="Translucent">-->
			<ObjectHeader responsive="true" intro="{prEgpData>/EGPWS0016/projectdetail/field6}"
				title="{prEgpData>/EGPWS0016/projectdetail/field19} / {prEgpData>/EGPWS0016/projectdetail/field5}"
				number="{ path: 'prEgpData>/EGPWS0016/budgetdetail/field5', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"
				numberUnit="THB" numberState="Success" backgroundDesign="Translucent">
				<attributes></attributes>
			</ObjectHeader>
			<FlexBox id="idFlexBoxEgp" renderType="Bare" direction="{= ${device>/system/desktop} ? 'Row' : 'Column'}" class="sapUiSmallMarginTop">
				<core:Fragment fragmentName="com.cu.s4hana.zlpuba001.view.fragment.EgpListDialog" type="XML"/>
				<FlexBox direction="Column" justifyContent="Center" alignContent="Center" alignItems="Center" class="sapUiTinyMargin">
					<Button icon="{= ${device>/system/desktop} ? 'sap-icon://open-command-field' : 'sap-icon://expand-group'}" type="Ghost" enabled="false"/>
				</FlexBox>
				<core:Fragment fragmentName="com.cu.s4hana.zlpuba001.view.fragment.PrListDialog" type="XML"/>
			</FlexBox>
		</content>
		<footer>
			<Toolbar>
				<Button icon="sap-icon://message-popup" type="Emphasized" text="{=${message>/}.length}" visible="{=!!${message>/}.length}"
					press="handleMessagePopoverPress"/>
				<ToolbarSpacer/>
				<Button text="{i18n>Button.Save}" type="Emphasized" press="handleSaveEgpPress"/>
				<Button text="{i18n>Button.Cancel}" type="Default" press="handleBackPress"/>
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
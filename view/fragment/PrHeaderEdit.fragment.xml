<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap"
	xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form" xmlns:commons="sap.suite.ui.commons" xmlns:f="sap.f">
	<uxap:ObjectPageLayout showTitleInHeaderContent="false" showHeaderContent="true" showEditHeaderButton="false" showFooter="true"
		class="sapUiSizeCompact">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:expandedHeading>
					<FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">
						<Title text="{prHeader>/BANFN}" wrapping="true" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
						<Text text="{prHeader>/BSART_NAME}"/>
					</FlexBox>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">
						<FlexBox wrap="NoWrap" fitContainer="true" alignItems="Center">
							<Title text="{prHeader>/BANFN}" wrapping="true" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
						</FlexBox>
						<FlexBox wrap="NoWrap" fitContainer="true" alignItems="Center" class="sapUiTinyMarginEnd">
							<Text text="{prHeader>/BSART_NAME}"/>
						</FlexBox>
					</FlexBox>
				</uxap:snappedHeading>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				<layout:VerticalLayout class="sapUiMediumMarginEnd">
					<Title text="{i18n>Label.Status}"/>
					<ObjectNumber number="{prHeader>/STATUS_NAME}" unit="" state="{path:'prHeader>/STATUS', formatter:'.formatter.parseStatus'}"/>
				</layout:VerticalLayout>
				<layout:VerticalLayout class="sapUiMediumMarginEnd">
					<Title text="{i18n>Label.TotalValue}"/>
					<ObjectNumber number="{path:'prHeader>/RLWRT', formatter:'.formatter.parseValue'}" unit="{prHeader>/WAERS}" state="Success"/>
				</layout:VerticalLayout>
			</FlexBox>
		</uxap:headerContent>
		<uxap:sections>
			<uxap:ObjectPageSection title="{i18n>Label.GeneralData}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Label.GeneralData}">
						<uxap:blocks>
							<layout:Grid defaultSpan="XL12 L12 M12 S12">
								<layout:content>
									<form:Form>
										<form:layout>
											<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0"
												emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2" singleContainerFullSize="false"/>
										</form:layout>
										<form:formContainers>
											<form:FormContainer title="">
												<form:formElements>
													<form:FormElement>
														<form:label>
															<Label text="{i18n>Label.PrDocType}" required="true"/>
														</form:label>
														<form:fields>
															<Input id="idDocumentType" value="{prHeader>/BSART}" change="onChangeDocumentType" type="Text" textAlign="Left" showValueHelp="true"
																valueHelpRequest="onVHDocumentType" enabled="true" visible="true" width="auto" valueHelpOnly="false"
																maxLength="{path:'/#PrHeader/BSART/@maxLength', formatter:'.formatter.parseInt'}"/>
															<Text text="{prHeader>/BSART_NAME}" class="sapUiTinyMarginTop"/>
														</form:fields>
													</form:FormElement>
													<form:FormElement visible="false">
														<form:label>
															<Label text="{i18n>Label.EgpNo}" required="false"/>
														</form:label>
														<form:fields>
															<Text text="{= ${prHeader>/E_GP_NR} !== '' ? ${prHeader>/E_GP_NR} : '-' }"/>
														</form:fields>
													</form:FormElement>
													<form:FormElement>
														<form:label>
															<Label text="" required="false"/>
														</form:label>
														<form:fields>
															<CheckBox text="{i18n>Label.NoPrintSign}" selected="{prItem>/0/ZZMM_NO_ESIGN}" editable="true"/>
														</form:fields>
													</form:FormElement>
												</form:formElements>
											</form:FormContainer>
											<form:FormContainer title="">
												<form:formElements>
													<form:FormElement>
														<form:label>
															<Label text="{i18n>Label.CreateBy}" required="false"/>
														</form:label>
														<form:fields>
															<Text text="{prHeader>/ERNAM_NAME}"/>
														</form:fields>
													</form:FormElement>
													<form:FormElement>
														<form:label>
															<Label text="{i18n>Label.CreateDate}" required="false"/>
														</form:label>
														<form:fields>
															<Text
																text="{path: 'prHeader>/BADAT', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy', UTC: false, style: 'short' } }"/>
														</form:fields>
													</form:FormElement>
												</form:formElements>
											</form:FormContainer>
										</form:formContainers>
									</form:Form>
								</layout:content>
							</layout:Grid>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection title="{i18n>Label.LongText}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Label.LongText}">
						<uxap:blocks>
							<IconTabBar headerMode="Inline" upperCase="false" expandable="false" expanded="true" backgroundDesign="Transparent" items="{prHeaderText>/}"
								applyContentPadding="true" showOverflowSelectList="true" class="sapUiResponsiveContentPadding myWidth">
								<items>
									<IconTabFilter icon="sap-icon://notes" design="Horizontal" iconColor="{= ${prHeaderText>DETAIL} !== '' ? 'Positive' : 'Neutral'}"
										text="{prHeaderText>TITLE}" tooltip="{prHeaderText>TITLE}" key="{prHeaderText>TDID}">
										<content>
											<TextArea rows="5" cols="200" editable="true" value="{prHeaderText>DETAIL}" liveChange="onTextBoxLiveChange" change="handleChangeLongText"/>
										</content>
									</IconTabFilter>
								</items>
							</IconTabBar>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection title="{i18n>Label.ItemList}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Label.ItemList}">
						<uxap:blocks>
							<Table width="100%" growing="false" mode="MultiSelect" itemPress="handlePrItemPress" items="{prItem>/}">
								<headerToolbar>
									<OverflowToolbar design="Transparent">
										<content>
											<ToolbarSpacer/>
											<Button text="{i18n>Button.Copy}" iconFirst="true" type="Transparent" press="handleCopyItem">
												<layoutData>
													<OverflowToolbarLayoutData moveToOverflow="true"/>
												</layoutData>
											</Button>
											<Button text="{i18n>Button.Cart}" iconFirst="true" type="Emphasized" press="handleAddToCart">
												<layoutData>
													<OverflowToolbarLayoutData moveToOverflow="true"/>
												</layoutData>
											</Button>
											<Button text="{i18n>Button.AddItem}" 
                                                enabled="{= ${prHeader>/BSART} === '1A31' || ${prHeader>/BSART} === '1INT' ?  true : false}" iconFirst="true" 
                                                type="{= ${prHeader>/BSART} === '1A31' || ${prHeader>/BSART} === '1INT' ?  'Accept' : 'Unstyled'}"
                                                press="handleAddItem">
												<layoutData>
													<OverflowToolbarLayoutData moveToOverflow="true"/>                                                                                                        
												</layoutData>
											</Button>
											<Button text="{i18n>Button.DeleteItem}" iconFirst="true" type="Reject" press="handleDeleteItem">
												<layoutData>
													<OverflowToolbarLayoutData moveToOverflow="true"/>
												</layoutData>
											</Button>
											<Button text="{i18n>Button.UnDeleteItem}" iconFirst="true" type="Default" press="handleUnDeleteItem">
												<layoutData>
													<OverflowToolbarLayoutData moveToOverflow="true"/>
												</layoutData>
											</Button>
										</content>
									</OverflowToolbar>
								</headerToolbar>
								<columns>
									<Column width="45px" hAlign="Center" vAlign="Middle" popinDisplay="Block" demandPopin="true" minScreenWidth="Tablet">
										<header>
											<Text text="{i18n>Label.ItemList}"/>
										</header>
									</Column>
									<Column width="auto" hAlign="Left" vAlign="Middle" demandPopin="false">
										<header>
											<VBox>
												<Text text="{i18n>Label.Material} /"/>
												<Text text="{i18n>Label.ShortText}"/>
											</VBox>
										</header>
									</Column>
									<Column width="120px" hAlign="Left" vAlign="Top" popinDisplay="Block" demandPopin="true" minScreenWidth="Tablet">
										<header>
											<Text text="{i18n>Label.MaterialGroup}"/>
										</header>
									</Column>
									<Column width="130px" hAlign="Left" vAlign="Top" popinDisplay="Block" demandPopin="true" minScreenWidth="Tablet">
										<header>
											<Text text="{i18n>Label.Plant}"/>
										</header>
									</Column>
									<Column width="110px" hAlign="Left" vAlign="Top" popinDisplay="Block" demandPopin="true" minScreenWidth="Tablet">
										<header>
											<Text text="{i18n>Label.PurchasingGroup}"/>
										</header>
									</Column>
									<Column width="180px" hAlign="Right" vAlign="Middle" popinDisplay="Block" demandPopin="true" minScreenWidth="Desktop">
										<header>
											<Text text="{i18n>Label.Quantity}"/>
										</header>
									</Column>
									<Column width="140px" hAlign="Right" vAlign="Middle" popinDisplay="Block" demandPopin="true" minScreenWidth="Desktop">
										<header>
											<Text text="{i18n>Label.UnitPrice}"/>
										</header>
									</Column>
									<Column width="140px" hAlign="Right" vAlign="Middle" popinDisplay="Block" demandPopin="true" minScreenWidth="Desktop">
										<header>
											<Text text="{i18n>Label.TotalValue}"/>
										</header>
									</Column>
								</columns>
								<items>
									<ColumnListItem type="Navigation" highlight="{path:'prItem>LOEKZ', formatter:'.formatter.formatRowHighlight'}">
										<cells>
											<Text text="{path:'prItem>BNFPO', formatter:'.formatter.parseInt'}"/>
											<ObjectIdentifier title="{prItem>MATNR}" text="{prItem>TXZ01}" titleActive="false" visible="true"/>
											<ObjectIdentifier title="{prItem>MATKL}" text="{prItem>MATKL_NAME}" titleActive="false" visible="true"/>
											<ObjectIdentifier title="{prItem>WERKS}" text="{prItem>WERKS_NAME}" titleActive="false" visible="true"/>
											<ObjectIdentifier title="{prItem>EKGRP}" text="{prItem>EKGRP_NAME}" titleActive="false" visible="true"/>
											<HBox>
												<Input value="{ path: 'prItem>MENGE', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2} }"
													textAlign="Right" change="onChangeQty" editable="{path:'prItem>',formatter:'.formatter.parseEditableByStatus'}"/>
												<Input value="{prItem>MEINS_NAME}" valueHelpOnly="false" textAlign="Center" change="onChangeUnit"
													maxLength="{path:'/#PrItem/MEINS_NAME/@maxLength', formatter:'.formatter.parseInt'}" valueHelpRequest="onVHUnit" showValueHelp="true"
													editable="{path:'prItem>',formatter:'.formatter.parseEditableByStatus'}"/>
											</HBox>
											<HBox alignItems="Center">
												<Input value="{ path: 'prItem>PREIS', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2} }"
													textAlign="Right" change="onChangeUnitPrice" editable="{path:'prItem>',formatter:'.formatter.parseEditableByStatus'}"/>
												<Text text="{prItem>WAERS}" width="30px" class="sapUiTinyMarginBegin"/>
											</HBox>
											<HBox alignItems="Center">
												<Input value="{ path: 'prItem>RLWRT', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2} }"
													textAlign="Right" change="onChangeTotalValue" editable="false"/>
												<Text text="{prItem>WAERS}" width="30px" class="sapUiTinyMarginBegin"/>
											</HBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection title="{i18n>Label.ProcessFlow}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Label.ProcessFlow}">
						<uxap:blocks>
							<core:Fragment fragmentName="com.cu.s4hana.zlpuba001.view.fragment.PrProcessFlow" type="XML"/>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
			<uxap:ObjectPageSection title="{i18n>Label.Attachment}">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>Label.Attachment}">
						<uxap:blocks>
							<UploadCollection uploadEnabled="true" uploadButtonInvisible="false" noDataText="{i18n>Label.NoAttachment}" maximumFileSize="{mFileSize>/limit}"
								instantUpload="false" mimeType="" multiple="false" uploadUrl="" mode="None" items="{attachmentModel>/}"
								beforeUploadStarts="handleFileBeforeUpload" uploadComplete="handleFileUploadComplete" uploadTerminated="handleFileUploadTerminate"
								fileSizeExceed="handleFileSizeExceed">
								<headerParameters/>
								<items>
									<UploadCollectionItem fileName="{attachmentModel>FILE_NAME}" mimeType="{attachmentModel>MIMETYPE}" enableDelete="true" visibleDelete="true"
										press="handleFilePress" deletePress="handleFileDelete">
										<attributes>
											<ObjectAttribute title=""
												text="{parts: ['attachmentModel>CREATE_DATE','attachmentModel>CREATE_TIME'] , formatter: '.formatter.parseUploadDateTime'}"/>
											<ObjectAttribute title="" text="{attachmentModel>CREATE_BY}"/>
											<ObjectAttribute title="" text="{ path : 'attachmentModel>FILE_SIZE' , formatter : '.formatter.formatFileSize' }"/>
										</attributes>
									</UploadCollectionItem>
								</items>
								<parameters/>
								<toolbar/>
							</UploadCollection>
						</uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
		<uxap:footer>
			<OverflowToolbar design="Auto" visible="{= ${controlModel>/mode} === 'EDIT' ? true : false }">
				<content>
					<Button icon="sap-icon://message-popup" type="Emphasized" text="{=${message>/}.length}" visible="{=!!${message>/}.length}"
						press="handleMessagePopoverPress"/>
					<ToolbarSpacer/>
					<Button text="{i18n>Button.DoCheckPr}" type="Emphasized" press="handleCheckPrPress"/>
					<Button text="{i18n>Button.Save}" type="Emphasized" press="handleSavePress"/>
					<Button text="{i18n>Button.HoldPr}" type="Ghost" visible="{= ${prHeader>/STATUS} === 'HOL'}" press="handleHoldPress"/>
					<Button text="{i18n>Button.UpdateEgpNumber}" type="Ghost" press="handleUpdateEgpPress"/>
					<Button text="{i18n>Button.CancelEdit}" type="Default" press="handleCancelEditPress"/>
				</content>
			</OverflowToolbar>
		</uxap:footer>
	</uxap:ObjectPageLayout>
</core:FragmentDefinition>